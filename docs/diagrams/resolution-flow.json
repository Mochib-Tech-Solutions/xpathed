{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Resolving one instruction",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      800,
      480
    ]
  },
  "participants": [
    {
      "id": "web",
      "type": "frontend",
      "label": "Web"
    },
    {
      "id": "client",
      "type": "backend",
      "label": "ClientApi"
    },
    {
      "id": "resolver",
      "type": "backend",
      "label": "Resolver"
    },
    {
      "id": "browser",
      "type": "backend",
      "label": "Browser"
    },
    {
      "id": "model",
      "type": "external",
      "label": "OpenRouter"
    }
  ],
  "messages": [
    {
      "id": "step1",
      "from": "web",
      "to": "client",
      "y": 160,
      "label": "Instruction + page ID",
      "variant": "default"
    },
    {
      "id": "step2",
      "from": "client",
      "to": "resolver",
      "y": 184,
      "label": "Resolve request",
      "variant": "default"
    },
    {
      "id": "step3",
      "from": "resolver",
      "to": "browser",
      "y": 208,
      "label": "Capture current view",
      "variant": "default"
    },
    {
      "id": "step4",
      "from": "browser",
      "to": "resolver",
      "y": 236,
      "label": "Candidates + capture ID",
      "variant": "return"
    },
    {
      "id": "step5",
      "from": "resolver",
      "to": "model",
      "y": 264,
      "label": "Instruction + evidence",
      "variant": "default"
    },
    {
      "id": "step6",
      "from": "model",
      "to": "resolver",
      "y": 292,
      "label": "Action + IDs + optional rule",
      "variant": "return"
    },
    {
      "id": "step7",
      "from": "resolver",
      "to": "browser",
      "y": 320,
      "label": "Capture + IDs + rule",
      "variant": "default"
    },
    {
      "id": "step8",
      "from": "browser",
      "to": "resolver",
      "y": 348,
      "label": "Verified XPath + state",
      "variant": "return"
    },
    {
      "id": "step9",
      "from": "resolver",
      "to": "client",
      "y": 372,
      "label": "Outcomes + usage",
      "variant": "return"
    },
    {
      "id": "step10",
      "from": "client",
      "to": "web",
      "y": 396,
      "label": "Chat result + costs",
      "variant": "return"
    }
  ]
}
