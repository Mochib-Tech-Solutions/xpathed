{
  "name": "xpathed-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "setup": "scripts/setup.sh && pnpm install --frozen-lockfile",
    "restore": "dotnet tool restore && pnpm restore:dotnet && pnpm install --frozen-lockfile",
    "restore:dotnet": "dotnet restore Xpathed.slnx --locked-mode",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run --no-bail --aggregate-output '/^build:(dotnet|web)$/'",
    "build:dotnet": "pnpm restore:dotnet && dotnet build Xpathed.slnx --no-restore --configuration Release",
    "build:web": "pnpm --filter xpathed build",
    "check": "scripts/check.sh",
    "check:dotnet": "pnpm build:dotnet && pnpm format:check:dotnet && pnpm test:dotnet",
    "check:web": "pnpm --filter xpathed run --no-bail --aggregate-output '/^(format:check|lint|test|build)$/'",
    "check:tooling": "pnpm run --no-bail --aggregate-output '/^(format:check:tooling|lint:scripts|test:tooling)$/'",
    "lint": "pnpm lint:dotnet && pnpm lint:web && pnpm lint:scripts",
    "lint:dotnet": "pnpm build:dotnet",
    "lint:web": "pnpm --filter xpathed lint",
    "lint:scripts": "for script in scripts/*.sh docker/*.sh .githooks/*; do sh -n \"$script\" || exit; done; node scripts/check-syntax.mjs",
    "format": "scripts/format.sh",
    "format:dotnet": "scripts/format.sh --write dotnet",
    "format:web": "pnpm --filter xpathed format",
    "format:tooling": "scripts/format.sh --write tooling",
    "format:check": "scripts/format.sh --check",
    "format:check:dotnet": "scripts/format.sh --check dotnet",
    "format:check:tooling": "scripts/format.sh --check tooling",
    "test": "pnpm run --no-bail --aggregate-output '/^test:(dotnet|web|tooling)$/'",
    "test:unit": "pnpm test",
    "test:dotnet": "node scripts/ci-dotnet-tests.mjs",
    "test:web": "pnpm --filter xpathed test",
    "test:web:watch": "pnpm --filter xpathed test:watch",
    "test:tooling": "node --test 'scripts/**/*.test.mjs' 'evaluation/**/*.test.mjs'",
    "docker:check": "scripts/ci-docker.sh",
    "docker:up": "scripts/setup.sh && docker/compose.sh up --build -d",
    "docker:build": "scripts/setup.sh && docker/compose.sh build",
    "docker:down": "docker/compose.sh down",
    "docker:logs": "docker/compose.sh logs --follow --tail 100",
    "docker:status": "docker/compose.sh ps",
    "clean": "node scripts/clean.mjs",
    "test:browser": "sh scripts/resolution-check.sh --browser-only",
    "test:resolution": "scripts/resolution-check.sh",
    "test:resolution:live": "scripts/resolution-check.sh --live",
    "evaluate": "node scripts/evaluate-all.mjs",
    "evaluate:model:live": "scripts/evaluate.sh --model --mode live",
    "evaluate:xpath": "scripts/evaluate.sh --xpath",
    "evaluate:resolver": "scripts/evaluate.sh",
    "evaluate:resolver:live": "scripts/evaluate.sh --mode live",
    "evaluate:qualify": "scripts/evaluate.sh --qualification",
    "evaluate:qualify:replay": "node evaluation/compare.mjs --replay",
    "release:seal": "node scripts/release/evidence.mjs seal",
    "release:verify": "node scripts/release/evidence.mjs verify",
    "release:bundle": "node scripts/release/bundle.mjs create",
    "release:bundle:verify": "node scripts/release/bundle.mjs verify",
    "release:bundle:restore": "node scripts/release/bundle.mjs restore",
    "release:evaluate": "node scripts/release/evaluate.mjs",
    "evaluate:replay": "node evaluation/run.mjs --replay",
    "datasets:fetch": "node evaluation/datasets/sources.mjs",
    "datasets:import": "node evaluation/datasets/import.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:staged": "node scripts/pre-commit.mjs",
    "release:archive": "node scripts/release/archive.mjs pack",
    "release:archive:restore": "node scripts/release/archive.mjs restore",
    "release:download": "node scripts/release/download.mjs",
    "release:monitor": "node scripts/release/monitor.mjs",
    "datasets:collection": "node evaluation/datasets/collection.mjs",
    "evaluate:compare": "scripts/evaluate.sh --comparison",
    "evaluate:compare:replay": "node evaluation/research/compare.mjs --replay"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
