{
  "name": "xpathed-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "setup": "scripts/setup.sh && pnpm install --frozen-lockfile",
    "restore": "dotnet tool restore && pnpm restore:dotnet && pnpm install --frozen-lockfile",
    "restore:dotnet": "dotnet restore Xpathed.slnx --locked-mode",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:dotnet && pnpm build:web",
    "build:dotnet": "pnpm restore:dotnet && dotnet build Xpathed.slnx --no-restore --configuration Release",
    "build:web": "pnpm --filter xpathed build",
    "check": "scripts/check.sh",
    "check:dotnet": "pnpm build:dotnet && pnpm format:check:dotnet && pnpm test:dotnet",
    "check:web": "pnpm --filter xpathed check && pnpm build:web",
    "check:tooling": "pnpm format:check:tooling && pnpm lint:scripts && pnpm test:tooling",
    "lint": "pnpm lint:dotnet && pnpm lint:web && pnpm lint:scripts",
    "lint:dotnet": "pnpm build:dotnet",
    "lint:web": "pnpm --filter xpathed lint",
    "lint:scripts": "for script in scripts/*.sh docker/*.sh; do sh -n \"$script\" || exit; done; for script in scripts/*.mjs tests/resolution/*.mjs evaluation/*.mjs evaluation/*.js; do node --check \"$script\" || exit; done",
    "format": "scripts/format.sh",
    "format:dotnet": "scripts/format.sh --write dotnet",
    "format:web": "pnpm --filter xpathed format",
    "format:tooling": "scripts/format.sh --write tooling",
    "format:check": "scripts/format.sh --check",
    "format:check:dotnet": "scripts/format.sh --check dotnet",
    "format:check:tooling": "scripts/format.sh --check tooling",
    "test": "pnpm test:dotnet && pnpm test:web && pnpm test:tooling",
    "test:unit": "pnpm test",
    "test:dotnet": "node scripts/ci-dotnet-tests.mjs",
    "test:persistence": "node scripts/ci-dotnet-tests.mjs persistence",
    "test:web": "pnpm --filter xpathed test",
    "test:web:watch": "pnpm --filter xpathed test:watch",
    "test:tooling": "node --test scripts/*.test.mjs evaluation/*.test.mjs",
    "docker:check": "scripts/ci-docker.sh",
    "docker:up": "scripts/setup.sh && docker/compose.sh up --build -d",
    "docker:build": "scripts/setup.sh && docker/compose.sh build",
    "docker:down": "docker/compose.sh down",
    "docker:logs": "docker/compose.sh logs --follow --tail 100",
    "docker:status": "docker/compose.sh ps",
    "clean": "node scripts/clean.mjs",
    "test:resolution": "scripts/resolution-check.sh",
    "test:resolution:live": "scripts/resolution-check.sh --live",
    "diagnostics": "scripts/diagnostics.sh",
    "evaluate": "scripts/evaluate.sh",
    "evaluate:live": "scripts/evaluate.sh --mode live",
    "evaluate:compare": "scripts/evaluate.sh --comparison",
    "evaluate:compare:replay": "node evaluation/compare.mjs --replay",
    "evaluate:qualify": "scripts/evaluate.sh --qualification",
    "evaluate:qualify:replay": "node evaluation/qualify.mjs --replay",
    "evaluate:replay": "node evaluation/run.mjs --replay",
    "datasets:fetch": "node evaluation/dataset-sources.mjs",
    "datasets:import": "node evaluation/datasets.mjs",
    "evaluate:dataset": "node evaluation/dataset-run.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
