[Unit]
Description=xpathed Browser
After=network-online.target
Wants=network-online.target
Requires=xpathed-network.service
After=xpathed-network.service

[Service]
Type=simple
User=xpathed-browser
Group=xpathed-browser
WorkingDirectory=/opt/xpathed/current/browser
ExecStart=/opt/dotnet/dotnet /opt/xpathed/current/browser/Browser.dll --BrowserExecutablePath=/opt/xpathed/current/chromium/chrome-headless-shell
Environment=ASPNETCORE_URLS=http://127.0.0.1:18081
Environment=HOME=/tmp XDG_CONFIG_HOME=/tmp/.config XDG_CACHE_HOME=/tmp/.cache
EnvironmentFile=/etc/xpathed/browser.env
MemoryMax=4G
# A Chromium child exhausting memory must not stop other browser sessions.
OOMPolicy=continue
CPUQuota=250%
TasksMax=1024
ExecStartPre=+/usr/bin/python3 /usr/local/lib/xpathed/network-policy.py --verify
InaccessiblePaths=/etc/xpathed /var/lib/caddy /opt/xpathed/current/resolver /opt/xpathed/current/client-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillMode=control-group
UMask=0077
Environment=ASPNETCORE_ENVIRONMENT=Production DOTNET_EnableDiagnostics=0 Logging__LogLevel__Default=Warning
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @obsolete @privileged
# Chromium drops credentials and filesystem access inside its user namespace.
SystemCallFilter=capset chroot
LimitCORE=0

[Install]
WantedBy=multi-user.target
