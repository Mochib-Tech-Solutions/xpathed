{$XPATHED_HOST} {
    route {
        header {
            -Server
            Strict-Transport-Security "max-age=15552000"
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
            X-Frame-Options DENY
            Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://{$XPATHED_HOST}; frame-ancestors 'none'"
            Cache-Control no-store
        }
        @foreign_origin {
            header Origin *
            not header Origin https://{$XPATHED_HOST}
        }
        respond @foreign_origin 403
        @foreign_fetch {
            path /api/* /view/*
            header Sec-Fetch-Site cross-site
            header Sec-Fetch-Site same-site
        }
        respond @foreign_fetch 403
        @private_path path /.* /internal/*
        respond @private_path 404
        request_header /health -Origin
        @browser_origin header Origin https://{$XPATHED_HOST}
        request_header @browser_origin Origin http://localhost:8080
        request_body {
            max_size 16KiB
        }
        handle /health {
            reverse_proxy 127.0.0.1:18083 {
                header_up Host localhost:8080
                header_up -Authorization
            }
        }
        handle /view/health {
            rewrite * /health
            reverse_proxy 127.0.0.1:18081
        }
        handle /api/* {
            reverse_proxy 127.0.0.1:18083 {
                header_up Host localhost:8080
                header_up -Authorization
            }
        }
        handle /view/* {
            reverse_proxy 127.0.0.1:18081 {
                header_up Host localhost:8080
                header_up -Authorization
            }
        }
        handle {
            root * /opt/xpathed/current/web
            try_files {path} /index.html
            file_server
        }
    }
}
