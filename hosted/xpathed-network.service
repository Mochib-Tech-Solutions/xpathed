[Unit]
Description=xpathed Browser outbound network policy
Before=xpathed-browser.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/xpathed/network-policy.py --install
ExecReload=/usr/bin/python3 /usr/local/lib/xpathed/network-policy.py --install
User=root
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
