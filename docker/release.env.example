# Copy to .env in the downloaded release directory and supply your settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=wafer
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_TIMEOUT_SECONDS=30
BROWSER_PORT=8082
RESOLVER_PORT=8083
VIEWER_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BROWSER_MAX_SESSIONS=4
