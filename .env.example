# Required only for live instruction resolution; never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=wafer
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_TIMEOUT_SECONDS=30
# Shared per-process limits. Positive integers; no queue or automatic retry.
API_REQUESTS_PER_MINUTE=120
API_CONCURRENT_REQUESTS=8
MODEL_CALLS_PER_MINUTE=20
MODEL_CALLS_PER_DAY=1000
MODEL_CONCURRENT_CALLS=2
# A provider-side credit limit on a dedicated application key is the dollar cap.

# Native development: workspace port plus three consecutive loopback API ports.
XPATHED_PORT=8080
# Optional override when Chrome or Chromium is not installed in a standard location.
BROWSER_EXECUTABLE_PATH=
