# scripts/setup.sh generates this password in .env.
POSTGRES_PASSWORD=
# Required only for live instruction resolution; never commit .env.
OPENROUTER_API_KEY=
# Separate key for explicitly requested live evaluations; its provider-side limit controls spending.
OPENROUTER_EVAL_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDER=wafer
